table inet splitdpi {
	chain postnat {
		type filter hook postrouting priority 101; policy accept;
		oifname "lo" return
		oifname "wg*" return
		oifname "tun*" return
		oifname "tailscale*" return
		meta mark and 0x40000000 == 0 tcp dport { 443 } ct original packets 1-20 meta mark set meta mark or 0x20000000 counter queue num 200 bypass
		meta mark and 0x40000000 == 0 udp dport { 50000-50100, 19294-19344, 3478-3481, 5349, 1400 } ct original packets 1-5 meta mark set meta mark or 0x20000000 counter queue num 200 bypass
	}
	chain prenat {
		type filter hook prerouting priority -101; policy accept;
		iifname "lo" return
		iifname "wg*" return
		iifname "tun*" return
		iifname "tailscale*" return
		meta mark and 0x40000000 == 0 tcp sport { 443 } ct reply packets 1-10 counter queue num 200 bypass
		meta mark and 0x40000000 == 0 udp sport { 50000-50100, 19294-19344, 3478-3481, 5349, 1400 } ct reply packets 1-3 counter queue num 200 bypass
	}
	chain predefrag {
		type filter hook output priority -401; policy accept;
		meta mark and 0x40000000 != 0 jump predefrag_nfqws comment "nfqws generated : avoid drop by INVALID conntrack state"
	}
	chain predefrag_nfqws {
		meta mark and 0x20000000 != 0 notrack comment "postnat traffic"
		ip frag-off & 0x1fff != 0 notrack comment "ipfrag"
		exthdr frag exists notrack comment "ipfrag"
		tcp flags ! syn,rst,ack notrack comment "datanoack"
	}
}
